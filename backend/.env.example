# ── Server ────────────────────────────────────────────
PORT=8000
ENV=development

# ── PostgreSQL (Option A: Cloud URL — Neon / Supabase / Render) ──
# DATABASE_URL=postgresql://user:password@ep-example.neon.tech/plated_db?sslmode=require

# ── PostgreSQL (Option B: Local dev fields) ───────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plated_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── JWT ───────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_MINUTES=10080

# ── Frontend URL(s) for CORS (comma-separated allowed) ─
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=

# ── File storage (local disk in dev; swap for S3 later) ─
UPLOAD_DIR=uploads
