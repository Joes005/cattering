# ── Server ────────────────────────────────────────────
PORT=8000
ENV=development

# ── PostgreSQL ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plated_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── JWT ───────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_MINUTES=10080

# ── Frontend URL (CORS) ────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── File storage (local disk in dev; swap for S3 later) ─
UPLOAD_DIR=uploads
